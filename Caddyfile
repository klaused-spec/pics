# Caddyfile - Reverse proxy HTTPS para o app Pics (Windows)
#
# Fluxo:
#   Navegador / App  --HTTPS-->  Caddy (8443)  -->  /api/*  -->  uvicorn  (localhost:8000)
#                                               -->  restante -->  build do frontend (dist)
#
# Certificado emitido pelo certbot via DNS-01 MANUAL na Hostinger.
# O Caddy apenas USA o certificado (não faz ACME por conta própria).
# Gere/renove o certificado com: powershell .\issue-cert.ps1
{
	# Desliga o ACME automático do Caddy (usamos o cert do certbot)
	auto_https off
}

# --- Bloco de TESTE sem SSL (HTTP puro na 8080) ---
# Acesse http://localhost:8080 para testar sem lidar com certificado.
:8181 {
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
	handle {
		root * C:\src\pics\frontend\dist
		try_files {path} /index.html
		file_server
	}
}

pics.meulavoro.com.br:8443 {
	# Certificado gerado pelo certbot (ver issue-cert.ps1)
	tls C:\src\pics\tools\caddy\certs\fullchain.pem C:\src\pics\tools\caddy\certs\privkey.pem

	# Compressão só para o conteúdo NÃO-API (frontend estático). Respostas
	# grandes de JSON da API (manifesto de sync) comprimidas em streaming sobre
	# HTTP/2 abortavam em rede móvel ("http2: stream closed") e travavam o sync.
	@notapi {
		not path /api/*
	}
	encode @notapi gzip zstd

	# API -> backend uvicorn (mantém o /api no caminho encaminhado)
	# flush_interval -1 desliga o buffering: envia os bytes assim que chegam do
	# backend, evitando que a resposta fique presa em buffer sob HTTP/2.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	# Myrtille (RDP via browser) -> IIS local porta 80
	handle /Myrtille* {
		reverse_proxy 127.0.0.1:80 {
			header_up Host "pics.meulavoro.com.br:8443"
			header_up X-Forwarded-Proto "https"
			header_up X-Forwarded-Host "pics.meulavoro.com.br:8443"
			flush_interval -1
			header_down Location "http://localhost" "https://pics.meulavoro.com.br:8443"
			transport http {
				dial_timeout 10s
				response_header_timeout 60s
			}
		}
	}

	# Frontend SPA — todas as outras rotas servem o index.html (React Router)
	handle {
		root * C:\src\pics\frontend\dist
		try_files {path} /index.html
		file_server
	}

	# Cabeçalhos de segurança
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

}
