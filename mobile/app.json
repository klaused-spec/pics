{
  "expo": {
    "name": "PICS Mobile",
    "slug": "pics-mobile",
    "version": "0.5.2",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "./plugins/with-cleartext-traffic",
      [
        "expo-media-library",
        {
          "photosPermission": "O PICS salva as fotos e vídeos baixados na sua galeria.",
          "savePhotosPermission": "O PICS salva as fotos e vídeos baixados na sua galeria.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "android": {
      "package": "com.pics.mobile",
      "versionCode": 16,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "2f8317f6-4f61-4654-ab84-b9071d8e456e"
      }
    }
  }
}
